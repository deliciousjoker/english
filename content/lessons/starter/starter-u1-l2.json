      "items": ["four", "nine", "twelve", "sixteen", "twenty", "forty"]
    },
    {
      "type": "exercise",
      "kind": "dictation",
      "title": "Listen and write",
      "instructions": "Listen and write the number (1, 2, 3…).",
      "support": { "tr": "Dinle ve sayıyı rakamla yaz.", "ar": "استمع واكتب الرقم." },
      "items": [
        { "say": "fourteen", "text": "14" },
        { "say": "six", "text": "6" },
        { "say": "eleven", "text": "11" },
        { "say": "twenty", "text": "20" },
        { "say": "fifty", "text": "50" }
      ]
    },
    {
      "type": "writing",
      "title": "Write",
      "model": { "text": ["one, two, three …"] },
      "prompt": "Write the numbers 1 to 10 in words.",
      "support": { "tr": "1'den 10'a kadar sayıları yazıyla yaz.", "ar": "اكتب الأرقام من 1 إلى 10 بالحروف." },
      "minWords": 10,
      "checklist": ["I write ten numbers.", "I check the spelling: e.g. eight, not eigt."]
    },
    { "type": "wrapup", "title": "Can you do it?" }
