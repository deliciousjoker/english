{
  "id": "starter-u1-l2",
  "level": "starter",
  "unit": 1,
  "order": 2,
  "title": "Numbers and hello",
  "subtitle": "Count, say hello — and understand the teacher",
  "canDo": [
    "I can count from 0 to 20.",
    "I can say hello, goodbye, thank you and sorry.",
    "I can understand classroom instructions: listen, read, write, match…"
  ],
  "teacherNotes": [
    "Sayıları önce koro hâlinde sayın, sonra öğrenciler sırayla birer sayı söylesin (1, 2, 3… zinciri).",
    "-teen / -ty farkı (13 / 30, 15 / 50) en sık hata: vurgunun yerini abartarak gösterin: thirTEEN – THIRty.",
    "Sınıf talimatları çok önemli: sitedeki tüm alıştırma yönergeleri bu kelimelerle yazıldı. Sonraki derslerde yönergeleri İngilizce okumalarını bekleyin.",
    "Arap öğrencilere: sayılar soldan sağa okunur (١٢ = 12)."
  ],
  "sections": [
    {
      "type": "warmup",
      "title": "Warm-up",
      "prompts": [
        "Count with me: one, two, three…",
        "How do you say “thank you” in English?",
        "Say goodbye in your language. Now say it in English!"
      ]
    },
    {
