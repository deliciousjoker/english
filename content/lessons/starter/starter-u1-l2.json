        { "big": "12", "small": "twelve", "say": "twelve", "hint": { "tr": "on iki", "ar": "١٢" } },
        { "big": "13", "small": "thirteen", "say": "thirteen", "hint": { "tr": "on üç", "ar": "١٣" } },
