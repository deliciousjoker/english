        { "big": "2", "small": "two", "say": "two", "hint": { "tr": "iki", "ar": "٢" } },
        { "big": "3", "small": "three", "say": "three", "hint": { "tr": "üç", "ar": "٣" } },
        { "big": "4", "small": "four", "say": "four", "hint": { "tr": "dört", "ar": "٤" } },
        { "big": "5", "small": "five", "say": "five", "hint": { "tr": "beş", "ar": "٥" } },
