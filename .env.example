# Azure Speech (Text-to-Speech) — ses dosyalarını üretmek için.
# Bu dosyayı ".env" adıyla kopyala ve kendi değerlerini yaz. .env asla paylaşılmaz/yüklenmez.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Ücretsiz (F0) katmanda dakikada ~20 istek sınırı var; istekler arası bekleme (ms).
TTS_DELAY_MS=3200
